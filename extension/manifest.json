{
  "manifest_version": 3,
  "name": "Support Promise Vault Capture",
  "version": "0.1.0",
  "description": "Automatically detect support conversations and capture promises from the current page.",
  "permissions": ["storage", "tabs", "offscreen", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; worker-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "js": [
        "core/shared.js",
        "core/provider-registry.js",
        "core/capture-session.js",
        "core/full-thread-capture.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Support Promise Vault",
    "default_popup": "popup.html"
  }
}
